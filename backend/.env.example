# Port du serveur API
PORT=4000

# Adresse IP locale du PC hote (utilisee dans les messages/logs uniquement)
# A recuperer avec `ipconfig` (Windows) ou `ifconfig` / `ip a` (Mac/Linux)
HOST_LAN_IP=192.168.1.10

# Base de donnees PostgreSQL
DB_HOST=localhost
DB_PORT=5432
DB_NAME=ticket_app
DB_USER=postgres
DB_PASSWORD=postgres

# JWT
JWT_SECRET=change_this_secret_in_production
JWT_EXPIRES_IN=7d

# CORS - origine autorisee (le frontend Vite en dev)
CORS_ORIGIN=*
